{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunat-sire-web",
  "main": "web/dist/server/entry.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "web/dist/client"
  }
}
