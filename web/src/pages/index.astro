---
import Layout from "../layouts/Layout.astro";
import { flattenPeriodos, listPeriodos, serverCredentials } from "../lib/sire.ts";

const months = ["", "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

let items: ReturnType<typeof flattenPeriodos> = [];
let error: string | undefined;
try {
  const credentials = serverCredentials();
  items = flattenPeriodos(await listPeriodos(credentials));
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
const years = [...new Set(items.map((i) => i.year))];
---
<Layout title="SIRE · periodos">
  <h1>Periodos RVIE</h1>
  {error ? (
    <p class="err">{error}</p>
  ) : (
    years.map((year) => (
      <section>
        <h2>{year}</h2>
        <table>
          <thead>
            <tr>
              <th>Periodo</th>
              <th>Estado</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {items.filter((i) => i.year === year).map((i) => (
              <tr>
                <td>{months[Number(i.month)] ?? i.month} {i.year}</td>
                <td>
                  <span class:list={["badge", i.presentado ? "ok" : "wait"]}>{i.desEstado}</span>
                </td>
                <td><a href={`/periodo/${i.perTributario}`}>Ver registros</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  )}
</Layout>

<style>
  h2 { font-size: 1.05rem; margin: 1.4rem 0 0.5rem; }
  section + section { margin-top: 0.5rem; }
</style>
