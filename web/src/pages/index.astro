---
import Layout from "../layouts/Layout.astro";
import PeriodosView from "../components/PeriodosView";
import { flattenPeriodos, listPeriodos, serverCredentials } from "../lib/sire.ts";

let items: ReturnType<typeof flattenPeriodos> = [];
let error: string | undefined;
try {
  const credentials = await serverCredentials(Astro.locals);
  items = flattenPeriodos(await listPeriodos(credentials));
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
const current = items.find((i) => i.enCurso) ?? null;
---
<Layout title="SIRE · periodos">
  <PeriodosView client:load items={items} current={current} error={error} />
</Layout>
