---
import Layout from "../../layouts/Layout.astro";
import {
  fetchPropuestaCached,
  money,
  parsePeriodo,
  parseRvieZip,
  serverCredentials,
  shiftPeriodo,
  summarizeRvie,
  tipoLabel,
} from "../../lib/sire.ts";

const raw = Astro.params.periodo ?? "";
const months = ["", "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];

let title = `Periodo ${raw}`;
let error: string | undefined;
let emptyTicket: string | undefined;
let table: ReturnType<typeof parseRvieZip> | undefined;

try {
  const periodo = parsePeriodo(raw);
  title = `${months[Number(raw.slice(4, 6))] ?? raw} ${raw.slice(0, 4)}`;
  const credentials = serverCredentials();
  const result = await fetchPropuestaCached({ credentials, periodo });
  if (result.kind === "empty") {
    emptyTicket = result.ticket;
  } else {
    table = parseRvieZip(result.bytes);
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}

const kpis = table ? summarizeRvie(table.rows) : undefined;
const prev = /^\d{6}$/.test(raw) ? shiftPeriodo(raw, -1) : undefined;
let next: string | undefined;
if (/^\d{6}$/.test(raw)) {
  const candidate = shiftPeriodo(raw, 1);
  const now = new Date();
  const current = now.getFullYear() * 100 + (now.getMonth() + 1);
  if (Number(candidate) <= current) next = candidate;
}
---
<Layout title={`SIRE · ${title}`}>
  <p class="meta nav">
    <a href="/">← Periodos</a>
    {prev ? <a href={`/periodo/${prev}`}>← {prev}</a> : null}
    {next ? <a href={`/periodo/${next}`}>{next} →</a> : <span>mes en curso</span>}
  </p>
  <h1>{title}</h1>
  {error ? (
    <p class="err">{error}</p>
  ) : emptyTicket ? (
    <p>SUNAT no devolvió comprobantes para este periodo.</p>
  ) : table && kpis ? (
    <>
      <section class="kpis">
        <article>
          <h2>Facturas</h2>
          <p class="big">{kpis.facturas.count}</p>
          <p>{money(kpis.facturas.total)}</p>
        </article>
        <article>
          <h2>Boletas</h2>
          <p class="big">{kpis.boletas.count}</p>
          <p>{money(kpis.boletas.total)}</p>
        </article>
        <article>
          <h2>N. crédito</h2>
          <p class="big">{kpis.notasCredito.count}</p>
          <p>{money(kpis.notasCredito.total)}</p>
        </article>
        <article>
          <h2>N. débito</h2>
          <p class="big">{kpis.notasDebito.count}</p>
          <p>{money(kpis.notasDebito.total)}</p>
        </article>
        <article>
          <h2>BI gravada (cas. 100)</h2>
          <p class="big">{money(kpis.netoBi)}</p>
          <p>bruta {money(kpis.bi)} · NC −{money(kpis.notasCredito.bi)}</p>
        </article>
        <article>
          <h2>IGV (cas. 101)</h2>
          <p class="big">{money(kpis.netoIgv)}</p>
          <p>neto a declarar {money(kpis.netoTotal)}</p>
        </article>
      </section>
      {(kpis.exonerado > 0 || kpis.inafecto > 0 || kpis.exportacion > 0) ? (
        <p class="meta">
          Exonerado {money(kpis.exonerado)} · inafecto {money(kpis.inafecto)} · exportación {money(kpis.exportacion)}
        </p>
      ) : null}
      <p class="meta">
        {kpis.count} comprobantes
        · <a href={`/periodo/${raw}/zip`}>Descargar ZIP SUNAT</a>
      </p>
      <div class="wrap">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Tipo</th>
              <th>Serie</th>
              <th>N°</th>
              <th>Cliente</th>
              <th>Doc</th>
              <th>BI</th>
              <th>IGV</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {table.rows.map((r) => (
              <tr>
                <td>{r.fecha}</td>
                <td>{tipoLabel(r.tipo)}</td>
                <td>{r.serie}</td>
                <td>{r.numero}</td>
                <td>{r.cliente}</td>
                <td class="num">{r.doc}</td>
                <td class="num">{r.bi}</td>
                <td class="num">{r.igv}</td>
                <td class="num">{r.total} {r.moneda}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ) : null}
</Layout>

<style>
  .nav { display: flex; gap: 1rem; }
  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.7rem;
    margin: 0 0 1rem;
  }
  .kpis article {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 0.75rem 0.85rem;
  }
  .kpis h2 {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 600;
  }
  .kpis .big {
    margin: 0.25rem 0 0.15rem;
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .kpis p { margin: 0; color: var(--muted); font-size: 0.85rem; }
  .wrap { overflow-x: auto; }
  table { min-width: 900px; }
</style>
