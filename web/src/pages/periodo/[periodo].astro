---
import Layout from "../../layouts/Layout.astro";
import PeriodoView from "../../components/PeriodoView";
import {
  buildPresentationPlan,
  fetchPropuestaCached,
  flattenPeriodos,
  listPeriodos,
  parsePeriodo,
  parseRceZip,
  parseRvieZip,
  serverCredentials,
  shiftPeriodo,
  summarizeRce,
  summarizeRvie,
} from "../../lib/sire.ts";

const raw = Astro.params.periodo ?? "";
const months = ["", "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];

let title = `Periodo ${raw}`;
let error: string | undefined;
let emptyTicket: string | undefined;
let table: ReturnType<typeof parseRvieZip> | undefined;
let compras: ReturnType<typeof parseRceZip> | undefined;
let rceLoaded = false;
let alreadyGenerated = false;

try {
  const periodo = parsePeriodo(raw);
  title = `${months[Number(raw.slice(4, 6))] ?? raw} ${raw.slice(0, 4)}`;
  const credentials = await serverCredentials(Astro.locals);
  const [listedRaw, ventasResult, comprasResult] = await Promise.all([
    listPeriodos(credentials),
    fetchPropuestaCached({ credentials, periodo, libro: "rvie" }),
    fetchPropuestaCached({ credentials, periodo, libro: "rce" }),
  ]);
  const listed = flattenPeriodos(listedRaw).find((i) => i.perTributario === raw);
  alreadyGenerated = listed?.presentado ?? false;
  if (ventasResult.kind === "empty") {
    emptyTicket = ventasResult.ticket;
  } else {
    table = parseRvieZip(ventasResult.bytes);
  }
  rceLoaded = true;
  if (comprasResult.kind === "file") {
    compras = parseRceZip(comprasResult.bytes);
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}

const kpis = table ? summarizeRvie(table.rows) : null;
const comprasKpis = compras ? summarizeRce(compras.rows) : null;

const plan = /^\d{6}$/.test(raw)
  ? buildPresentationPlan({
      periodo: raw,
      alreadyGenerated,
      rvieHasRows: (table?.rows.length ?? 0) > 0,
      rceLoaded,
      rceHasRows: (compras?.rows.length ?? 0) > 0,
    })
  : null;

const prev = /^\d{6}$/.test(raw) ? shiftPeriodo(raw, -1) : null;
let next: string | null = null;
if (/^\d{6}$/.test(raw)) {
  const candidate = shiftPeriodo(raw, 1);
  const now = new Date();
  const current = now.getFullYear() * 100 + (now.getMonth() + 1);
  if (Number(candidate) <= current) next = candidate;
}
---
<Layout title={`SIRE · ${title}`}>
  <PeriodoView
    client:load
    raw={raw}
    title={title}
    alreadyGenerated={alreadyGenerated}
    prev={prev}
    next={next}
    error={error}
    emptyTicket={emptyTicket}
    plan={plan}
    kpis={kpis}
    comprasKpis={comprasKpis}
    ventasRows={table?.rows ?? []}
    comprasRows={compras?.rows ?? []}
  />
</Layout>
