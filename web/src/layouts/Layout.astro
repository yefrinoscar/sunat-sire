---
import "../styles/global.css";

type Props = { title: string; description?: string };
const { title, description = "Consulta SIRE de SUNAT: propuesta RVIE y RCE, casillas del 621 y checklist de presentación." } = Astro.props;
---
<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf8f4" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const saved = localStorage.getItem("sire-theme");
      const dark = saved === "dark" || (saved === null && matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.classList.toggle("light", !dark);
    </script>
  </head>
  <body class="bg-background text-foreground min-h-dvh flex flex-col antialiased">
    <div class="app-backdrop" aria-hidden="true"></div>
    <div class="app-grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <div class="sticky top-0 z-40 pt-4 px-4 sm:px-6 pointer-events-none">
      <header class="max-w-[1200px] mx-auto pointer-events-auto">
        <div class="flex items-center gap-3 px-3 sm:px-4 h-14 rounded-full border border-divider bg-background/70 backdrop-blur-2xl shadow-[0_2px_24px_rgba(26,24,20,0.06)] dark:shadow-[0_2px_24px_rgba(0,0,0,0.3)]">
          <a href="/" class="group flex items-center gap-2.5 no-underline text-foreground min-w-0 shrink-0">
            <span class="relative inline-grid place-items-center size-8 rounded-full bg-gradient-to-br from-primary-500 to-primary-700 text-white shrink-0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                <path d="M9 7h7M9 11h5"></path>
              </svg>
            </span>
            <span class="leading-tight min-w-0 hidden xs:block sm:block">
              <span class="block font-display font-semibold text-[0.95rem] tracking-tight truncate">SIRE</span>
            </span>
          </a>

          <nav class="ml-auto flex items-center gap-0.5 sm:gap-1">
            <a href="/" class="inline-flex items-center h-8 px-3 sm:px-4 rounded-full text-sm font-medium text-default-600 hover:text-foreground hover:bg-content2/80 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] no-underline">
              Periodos
            </a>
            <a href="https://e-menu.sunat.gob.pe/cl-ti-itmenu/MenuInternet.htm" target="_blank" rel="noreferrer" class="hidden sm:inline-flex items-center gap-1.5 h-8 px-4 rounded-full text-sm font-medium text-default-600 hover:text-foreground hover:bg-content2/80 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] no-underline">
              SOL
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9"></path>
              </svg>
            </a>
            <button id="theme-toggle" type="button" aria-label="Cambiar tema" class="inline-grid place-items-center size-8 rounded-full text-default-500 hover:text-foreground hover:bg-content2/80 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] cursor-pointer ml-0.5">
              <svg class="hidden dark:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
              </svg>
              <svg class="dark:hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
              </svg>
            </button>
          </nav>
        </div>
      </header>
    </div>

    <main id="main" class="max-w-[1200px] w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex-1">
      <slot />
    </main>

    <footer class="mt-16 pb-8">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
        <div class="bezel">
          <div class="bezel-inner px-5 py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-default-500">
            <p class="flex items-center gap-2">
              <span class="inline-block size-1.5 rounded-full bg-primary animate-pulse"></span>
              Solo lectura — los envíos se hacen con tu clave SOL en SUNAT.
            </p>
            <p class="ml-auto font-mono text-[0.65rem] uppercase tracking-[0.14em] text-default-400">RVIE · RCE · FV 621</p>
          </div>
        </div>
      </div>
    </footer>

    <div id="nav-progress" aria-hidden="true"></div>
  </body>
</html>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const dark = !root.classList.contains("dark");
    root.classList.toggle("dark", dark);
    root.classList.toggle("light", !dark);
    localStorage.setItem("sire-theme", dark ? "dark" : "light");
  });

  const bar = document.getElementById("nav-progress");
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement | null)?.closest?.("a");
    if (!link || !bar) return;
    const href = link.getAttribute("href");
    if (!href || href.startsWith("#") || link.target === "_blank") return;
    if (link.dataset.navBar) return;
    bar.classList.add("active");
    bar.dataset.navBar = "1";
    setTimeout(() => delete bar.dataset.navBar, 4000);
  });
</script>
