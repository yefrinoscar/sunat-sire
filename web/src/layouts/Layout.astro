---
import "../styles/global.css";

type Props = { title: string; description?: string };
const { title, description = "Consulta SIRE de SUNAT: propuesta RVIE y RCE, casillas del 621 y checklist de presentación." } = Astro.props;
---
<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // aplica el tema guardado antes del primer paint para evitar flash
      const saved = localStorage.getItem("sire-theme");
      const dark = saved === "dark" || (saved === null && matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.classList.toggle("light", !dark);
    </script>
  </head>
  <body class="bg-background text-foreground min-h-dvh flex flex-col antialiased">
    <div class="app-backdrop" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <header class="sticky top-0 z-40 border-b border-divider bg-background/75 backdrop-blur-xl">
      <div class="max-w-[1200px] mx-auto flex items-center gap-3 px-4 sm:px-6 h-16">
        <a href="/" class="group flex items-center gap-3 no-underline text-foreground min-w-0">
          <span class="relative inline-grid place-items-center size-9 rounded-[10px] bg-gradient-to-br from-primary-500 to-primary-800 text-white shadow-md shadow-primary-600/25 shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              <path d="M9 7h7M9 11h7"></path>
            </svg>
          </span>
          <span class="leading-tight min-w-0">
            <span class="block font-display font-semibold text-[1.05rem] tracking-tight truncate">Sire Ledger</span>
            <span class="block text-[0.68rem] uppercase tracking-[0.14em] text-default-500 font-medium truncate">SUNAT · RVIE + RCE</span>
          </span>
        </a>

        <nav class="ml-auto flex items-center gap-1 sm:gap-2">
          <a href="/" class="hidden sm:inline-flex items-center h-9 px-3 rounded-medium text-sm font-medium text-default-600 hover:text-foreground hover:bg-content2 transition-colors no-underline">
            Periodos
          </a>
          <a href="https://e-menu.sunat.gob.pe/cl-ti-itmenu/MenuInternet.htm" target="_blank" rel="noreferrer" class="hidden sm:inline-flex items-center gap-1.5 h-9 px-3 rounded-medium text-sm font-medium text-default-600 hover:text-foreground hover:bg-content2 transition-colors no-underline">
            SUNAT SOL
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9"></path>
            </svg>
          </a>
          <button id="theme-toggle" type="button" aria-label="Cambiar tema" class="inline-grid place-items-center size-9 rounded-medium border border-divider bg-content1 text-default-600 hover:text-foreground hover:border-default-300 transition-colors cursor-pointer">
            <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="max-w-[1200px] w-full mx-auto px-4 sm:px-6 py-6 sm:py-10 flex-1">
      <slot />
    </main>

    <footer class="border-t border-divider mt-10">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-default-500">
        <p class="flex items-center gap-1.5">
          <span class="inline-block size-1.5 rounded-full bg-primary"></span>
          App de solo lectura: los envíos a SUNAT se hacen con tu clave SOL.
        </p>
        <p class="ml-auto font-mono text-[0.68rem] uppercase tracking-wider">SIRE · libros electrónicos</p>
      </div>
    </footer>

    <div id="nav-progress" aria-hidden="true"></div>
  </body>
</html>

<script>
  // Alterna tema claro/oscuro y lo persiste.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const dark = !root.classList.contains("dark");
    root.classList.toggle("dark", dark);
    root.classList.toggle("light", !dark);
    localStorage.setItem("sire-theme", dark ? "dark" : "light");
  });

  // Barra superior indeterminada mientras se consulta a SUNAT al navegar.
  const bar = document.getElementById("nav-progress");
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement | null)?.closest?.("a");
    if (!link || !bar) return;
    const href = link.getAttribute("href");
    if (!href || href.startsWith("#") || link.target === "_blank") return;
    if (link.dataset.navBar) return;
    bar.classList.add("active");
    bar.dataset.navBar = "1";
    setTimeout(() => delete bar.dataset.navBar, 4000);
  });
</script>
