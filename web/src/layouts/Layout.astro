---
import "../styles/global.css";

type Props = { title: string; description?: string };
const { title, description = "Consulta SIRE de SUNAT: propuesta RVIE y RCE, casillas del 621 y checklist de presentación." } = Astro.props;
---
<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground min-h-dvh">
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="sticky top-0 z-40 border-b border-divider bg-content1/80 backdrop-blur-md">
      <div class="max-w-[1180px] mx-auto flex items-center gap-4 px-4 sm:px-6 h-14">
        <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight no-underline text-foreground">
          <span class="inline-grid place-items-center size-7 rounded-medium bg-primary/10 text-primary font-extrabold">S</span>
          SIRE · RVIE
        </a>
        <span class="hidden sm:inline text-default-400 text-sm">SUNAT · libros electrónicos</span>
      </div>
    </header>
    <main id="main" class="max-w-[1180px] mx-auto p-4 sm:p-6">
      <slot />
    </main>
    <div id="nav-progress" aria-hidden="true"></div>
  </body>
</html>

<script>
  // Barra superior indeterminada mientras se consulta a SUNAT al navegar.
  const bar = document.getElementById("nav-progress");
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement | null)?.closest?.("a");
    if (!link || !bar) return;
    const href = link.getAttribute("href");
    if (!href || href.startsWith("#") || link.target === "_blank") return;
    if (link.dataset.navBar) return;
    bar.classList.add("active");
    bar.dataset.navBar = "1";
    setTimeout(() => delete bar.dataset.navBar, 4000);
  });
</script>
